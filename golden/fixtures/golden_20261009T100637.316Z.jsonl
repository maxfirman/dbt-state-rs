{"service":"SQL","method":"SubmitEnrichedSQL","recorded_at":"2026-10-09T10:06:54.305370401+00:00","metadata":[["x-request-id","13055191d5b4452984dac3b77bad117c"],["x-session-id","a3f79204c8864e5b94d96eef23fb16e4"],["x-submitted-at-epoch","1791540414039"],["x-system-user-id",""],["x-os-name","linux"],["x-dbt-invocation-id","01a12021-13b5-77b2-b91c-09ec66e7333c"],["te","trailers"],["content-type","application/grpc"],["user-agent","tonic/0.14.6"]],"request":{"target_table":"\"ANALYTICS_DB\".\"DEV_CLONE\".\"ORDERS_INCREMENTAL\"","dialect":"snowflake","default_catalog":"ANALYTICS_DB","execution_type":3,"sql":"\n\n-- Incremental model to exercise dbt State clone/defer decisions.\nselect\n    order_id,\n    customer_id,\n    ordered_at,\n    subtotal,\n    tax_paid,\n    order_total\nfrom ANALYTICS_DB.dev_clone.stg_orders\n\n\nwhere ordered_at > (select coalesce(max(ordered_at), '1900-01-01') from ANALYTICS_DB.dev_clone.orders_incremental)\n","tables":[{"name":"\"ANALYTICS_DB\".\"DEV_CLONE\".\"ORDERS_INCREMENTAL\"","last_modified_epoch":1791540410292},{"name":"\"ANALYTICS_DB\".\"RAW\".\"RAW_ORDERS\"","last_modified_epoch":1791320590839}],"query_dependencies":[{"name":"\"ANALYTICS_DB\".\"DEV_CLONE\".\"STG_ORDERS\"","query":"create or replace view STG_ORDERS(\n\tORDER_ID,\n\tLOCATION_ID,\n\tCUSTOMER_ID,\n\tSUBTOTAL_CENTS,\n\tTAX_PAID_CENTS,\n\tORDER_TOTAL_CENTS,\n\tSUBTOTAL,\n\tTAX_PAID,\n\tORDER_TOTAL,\n\tORDERED_AT\n) as (\n    with\n\nsource as (\n\n    select * from ANALYTICS_DB.raw.raw_orders\n\n),\n\nrenamed as (\n\n    select\n\n        ----------  ids\n        id as order_id,\n        store_id as location_id,\n        customer as customer_id,\n\n        ---------- numerics\n        subtotal as subtotal_cents,\n        tax_paid as tax_paid_cents,\n        order_total as order_total_cents,\n        (subtotal / 100)::numeric(16, 2) as subtotal,\n        (tax_paid / 100)::numeric(16, 2) as tax_paid,\n        (order_total / 100)::numeric(16, 2) as order_total,\n\n        